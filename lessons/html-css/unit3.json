          "options": [
            "ورود ایمیل",
            "انتخاب رنگ",
            "پخش صدا"
          ],
          "answer": "ورود ایمیل"
        },
        {
          "type": "code_exercise",
          "prompt": "یک ورودی متن برای نام بساز.",
          "explanation": "type=text ورودی متنی می‌سازد.",
          "starter_code": "<input type=\"text\" name=\"name\">",
          "tests": [
            {
              "expected_output": "<input type=\"text\" name=\"name\">"
            }
          ]
        }
      ]
    }
  ]
